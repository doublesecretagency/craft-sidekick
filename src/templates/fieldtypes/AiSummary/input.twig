{% import '_includes/forms' as forms %}

{% set bundle = view.registerAssetBundle('doublesecretagency\\sidekick\\assetbundles\\FieldsAssetBundle') %}

{# Get info icon from the bundle's folder, which Craft Cloud uploads at build time #}
{% set infoIcon = bundle.baseUrl ~ '/images/information.svg' %}

{{ forms.textarea({
    name: field.handle,
    value: value,
    readonly: (field.fieldMode == 'readOnly'),
    disabled: (field.fieldMode == 'disabled'),
    rows: field.initialRows ?: 3,
}) }}

<div class="ai-summary-field">
    <div style="text-align: left;">
        <img
            src="{{ infoIcon }}"
            alt="{{ field.summaryInstructions }}"
            title="{{ field.summaryInstructions }}"
            aria-label="{{ field.summaryInstructions }}"
{#            alt="{{ 'See complete field instructions'|t }}"#}
{#            title="{{ 'See complete field instructions'|t }}"#}
{#            aria-label="{{ 'See complete field instructions'|t }}"#}
        />
    </div>
    <div style="text-align: right;">
        <div class="ai-waiting" aria-hidden="true" role="status">
            Generating...
        </div>
        <div class="btngroup">
            <button type="button"
                    onclick="sidekickClear('{{ field.name }}', '{{ field.handle|namespaceInputName }}')"
                    class="btn small">
                Clear
            </button>
            {% if element.id %}
                <button type="button"
                        onclick="sidekickGenerate('{{ field.name }}', '{{ field.handle|namespaceInputName }}', {{ field.id }}, {{ element.id }}, {{ element.siteId }})"
                        class="btn small secondary">
                    Generate
                </button>
            {% endif %}
        </div>
    </div>
</div>
